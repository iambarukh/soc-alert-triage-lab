<dashboard version="1.1" theme="light">
  <label>SOC Alert Triage Dashboard</label>
  <description>Beginner SOC lab detection dashboard using Windows Security logs, Sysmon ingestion proof, and SPL detections.</description>

  <fieldset submitButton="false">
    <input type="time" token="time_tok">
      <label>Time Range</label>
      <default>
        <earliest>0</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <row>
    <panel>
      <title>Failed Login Attempts</title>
      <single>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4625
| stats count as Failed_Logins
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">1</option>
        <option name="showTrendIndicator">1</option>
        <option name="useColors">0</option>
        <option name="useThousandSeparators">1</option>
      </single>
    </panel>

    <panel>
      <title>New Users Created</title>
      <single>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4720
| stats count as New_Users_Created
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">1</option>
        <option name="showTrendIndicator">1</option>
        <option name="useColors">0</option>
        <option name="useThousandSeparators">1</option>
      </single>
    </panel>

    <panel>
      <title>Group Membership Changes</title>
      <single>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4732
| stats count as Group_Changes
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">1</option>
        <option name="showTrendIndicator">1</option>
        <option name="useColors">0</option>
        <option name="useThousandSeparators">1</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>SOC Alert Summary</title>
      <chart>
        <search>
          <query><![CDATA[
index=wineventlog
| eval Detection=case(
    sourcetype="WinEventLog:Security" AND EventCode=4625, "Failed Login",
    sourcetype="WinEventLog:Security" AND EventCode=4720, "New User Created",
    sourcetype="WinEventLog:Security" AND EventCode=4732, "Group Membership Changed",
    source="WinEventLog:Microsoft-Windows-Sysmon/Operational", "Sysmon Activity"
)
| where isnotnull(Detection)
| stats count by Detection
| sort - count
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.legend.placement">right</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.axisTitleX.visibility">visible</option>
        <option name="charting.axisTitleY.visibility">visible</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Events by Source and Sourcetype</title>
      <table>
        <search>
          <query><![CDATA[
index=wineventlog
| stats count by source sourcetype
| sort - count
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Failed Login Details</title>
      <table>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4625
| table _time host Account_Name Account_Domain Failure_Reason Source_Network_Address Message
| sort - _time
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>New User Accounts Created</title>
      <table>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4720
| table _time host Account_Name Account_Domain Message
| sort - _time
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>

    <panel>
      <title>Group Membership Changes</title>
      <table>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4732
| table _time host Account_Name Account_Domain Message
| sort - _time
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Account Abuse Detection</title>
      <table>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" (EventCode=4720 OR EventCode=4732)
| eval Detection=case(
    EventCode=4720, "New User Created",
    EventCode=4732, "User Added to Group"
)
| table _time host EventCode Detection Account_Name Account_Domain Message
| sort - _time
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Sysmon Ingestion Proof</title>
      <table>
        <search>
          <query><![CDATA[
index=wineventlog source="WinEventLog:Microsoft-Windows-Sysmon/Operational"
| stats count as Sysmon_Events by source sourcetype host
| sort - Sysmon_Events
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Successful Logins by Account</title>
      <table>
        <search>
          <query><![CDATA[
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4624
| stats count as Successful_Logins by Account_Name
| sort - Successful_Logins
          ]]></query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</dashboard>
